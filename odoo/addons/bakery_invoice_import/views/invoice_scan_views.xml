<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bakery_invoice_scan_list" model="ir.ui.view">
        <field name="name">bakery.invoice.scan.list</field>
        <field name="model">bakery.invoice.scan</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'" decoration-muted="state == 'sent'">
                <field name="name"/>
                <field name="state" widget="badge"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="paper_number"/>
                <field name="flagged_count" string="Rows to check"/>
                <field name="move_id"/>
            </list>
        </field>
    </record>

    <record id="view_bakery_invoice_scan_form" model="ir.ui.view">
        <field name="name">bakery.invoice.scan.form</field>
        <field name="model">bakery.invoice.scan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_posted_invoice" string="Create and post invoice"
                            type="object" class="btn-primary" invisible="state != 'review'"/>
                    <button name="action_create_draft_invoice" string="Create draft only"
                            type="object" invisible="state != 'review'"/>
                    <field name="state" widget="statusbar" statusbar_visible="queued,review,sent"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="state != 'failed'">
                        <field name="failure_reason" readonly="1"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state not in ('queued', 'reading')">
                        This page is being read - refresh in a minute.
                    </div>
                    <h1><field name="name"/></h1>
                    <group invisible="state not in ('review', 'sent')">
                        <group>
                            <field name="partner_id" readonly="state == 'sent'"
                                   options="{'no_create_edit': False}" context="{'default_customer_rank': 1}"/>
                            <field name="invoice_date" readonly="state == 'sent'"/>
                            <field name="paper_number" readonly="state == 'sent'"/>
                            <label for="suggested_paper_number" string="Suggested number"
                                   invisible="not suggested_paper_number or state == 'sent'"/>
                            <div class="o_row" invisible="not suggested_paper_number or state == 'sent'">
                                <field name="suggested_paper_number" nolabel="1"/>
                                <button name="action_use_suggested_number" type="object"
                                        string="Use it" class="btn-link"/>
                            </div>
                        </group>
                        <group>
                            <field name="move_id" invisible="not move_id"/>
                            <field name="flagged_count" string="Rows to check"/>
                        </group>
                    </group>
                    <notebook invisible="state not in ('review', 'sent')">
                        <page string="Rows">
                            <field name="line_ids" readonly="state == 'sent'">
                                <list editable="bottom" create="false" delete="false"
                                      decoration-danger="flag_text">
                                    <field name="product_name"/>
                                    <field name="quantity"/>
                                    <field name="qty_image" widget="image" options="{'size': [0, 56]}"/>
                                    <field name="return_qty"/>
                                    <field name="return_image" widget="image" options="{'size': [0, 56]}"/>
                                    <field name="total_price"/>
                                    <field name="price_image" widget="image" options="{'size': [0, 56]}"/>
                                    <field name="flag_text" optional="hide"/>
                                    <field name="product_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Scanned page">
                            <field name="page_preview" widget="image" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bakery_invoice_scan" model="ir.actions.act_window">
        <field name="name">Scanned invoices</field>
        <field name="res_model">bakery.invoice.scan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Who still owes money: posted invoices not yet fully paid, by customer.
         To record a payment, tick the invoices a payment covers and use
         Actions > Register Payment (works across several at once). -->
    <record id="view_bakery_unpaid_list" model="ir.ui.view">
        <field name="name">bakery.unpaid.invoices.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="partner_id"/>
                <field name="ref" string="Paper invoice no."/>
                <field name="invoice_date"/>
                <field name="name" string="Odoo number"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_residual" string="Still owed" sum="Total owed"/>
                <field name="payment_state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_bakery_unpaid" model="ir.actions.act_window">
        <field name="name">Unpaid invoices</field>
        <field name="res_model">account.move</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]</field>
        <field name="context">{'group_by': ['partner_id'], 'default_move_type': 'out_invoice'}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_bakery_unpaid_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
    </record>

    <menuitem id="menu_bakery_root" name="Bakery Invoices" sequence="10"
              web_icon="account,static/description/icon.png"/>
    <menuitem id="menu_bakery_scans" name="Scanned invoices" parent="menu_bakery_root"
              action="action_bakery_invoice_scan" sequence="10"/>
    <menuitem id="menu_bakery_unpaid" name="Unpaid invoices" parent="menu_bakery_root"
              action="action_bakery_unpaid" sequence="15"/>
    <menuitem id="menu_bakery_upload" name="Upload scanned invoices" parent="menu_bakery_root"
              action="action_bakery_invoice_upload" sequence="20"/>
</odoo>
